# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Primary Cloud LLM (Groq)
GROQ_API_KEY=your_groq_api_key_here
GROQ_PRIMARY_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=qwen/qwen3.8-27b

# Offline / Local LLM Fallback (Ollama)
OLLAMA_BASE_URL=http://localhost:11434/api/generate
OLLAMA_MODEL=llama3.1:8b

# Sourcing Search Providers
SERPAPI_API_KEY=your_serpapi_key_here
EXA_API_KEY=your_exa_key_optional

# Search Execution & Caching
SEARCH_TIMEOUT_SECONDS=45
CACHE_TTL_HOURS=48
MAX_SEARCH_QUERIES_PER_JOB=4
MAX_RESULTS_PER_QUERY=10
MAX_CANDIDATES_EVALUATED=15

# Scoring Weights (Must sum to 1.0)
WEIGHT_MANDATORY=0.40
WEIGHT_TECHNICAL_SKILLS=0.25
WEIGHT_ROLE_ALIGNMENT=0.15
WEIGHT_EXPERIENCE=0.10
WEIGHT_PREFERRED=0.10
